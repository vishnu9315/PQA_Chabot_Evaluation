# PQA_ragas (MeitY PQA evaluation) — copy to .env and fill in. NEVER commit .env.
# Minimum to fill in: AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY (Bedrock), and for
# capture, PQA_CHATBOT_SESSION_FILE pointing at your own saved portal login.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Judge model (pinned; see config.py PINNED_MODEL_ID)
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-5
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# Extended thinking (probed on this model: type must be "adaptive"; effort is the
# sibling key output_config.effort). Effort default is medium — reasoning and the answer
# share ONE max_tokens budget on Bedrock (reference ISSUE-P10), and max can consume it all.
#BEDROCK_THINKING=adaptive
#BEDROCK_THINKING_EFFORT=medium

# Output ceiling (TOTAL, including reasoning tokens — reference ISSUE-9c)
#RAGAS_MAX_TOKENS=64000

# Pacing (AIMD limiter + token buckets; see ragas_eval/pacing.py)
#PACE_CONCURRENCY_START=3
#PACE_CONCURRENCY_MAX=10
#PACE_RPM=60
#PACE_TPM=200000

# Timeouts. context_precision scales per retrieved chunk (reference ISSUE-P7/P12).
#RAGAS_TIMEOUT=1800
#PER_CHUNK_TIMEOUT=300
#STALL_TIMEOUT=1800

# Judge-prompt calibration knobs. Context precision defaults to `hardened`, calibrated on
# this project's data on 2026-11-20 (docs/RAGAS_SCORING.md section 5); recall stays `stock`.
#CTX_PRECISION_JUDGE=hardened
#CTX_RECALL_JUDGE=stock

# ---------------------------------------------------------------------------------
# capture_new_chatbot.py — captures the NEW PQA chatbot's responses. Independent of
# everything above: no AWS/Bedrock credentials are needed to run a capture, only to
# later score the captured file with cli.py. See chatbot_endpoint_config.json and
# README.md's "Capturing the new chatbot's responses" section for the full contract.
# ---------------------------------------------------------------------------------

# Required. capture_new_chatbot.py exits with a setup message if unset.
# Confirmed MeitY endpoint (see chatbot_endpoint_config.json):
PQA_CHATBOT_BASE_URL=https://pqa.myscheme.in/meityy/api/assistant

# --- Authentication: the portal uses session cookies from an email-OTP login (confirmed
# 2026-11-20; see chatbot_endpoint_config.json "auth"). The pqa_session cookie lasts
# about 30 minutes after login, so log in again right before a long capture. ---

# Recommended. Path to a Playwright storageState JSON - the SAME file format the
# auth-capture/ folder's `npm run auth:capture` produces into auth-capture/.auth/*.json.
# Its cookies for PQA_CHATBOT_BASE_URL's host are sent as a Cookie header. Never commit a
# real session file; values are never logged by this script.
PQA_CHATBOT_SESSION_FILE=./auth-capture/.auth/default.json

# Alternative to PQA_CHATBOT_SESSION_FILE: paste a raw 'Cookie:' header value directly.
# Takes precedence over PQA_CHATBOT_SESSION_FILE if both are set. Example shape (not a
# real value): PQA_CHATBOT_COOKIE_HEADER=pqa_session=...; pqa_refresh=...
PQA_CHATBOT_COOKIE_HEADER=

# Optional fallback, sent as 'Authorization: Bearer <value>' if set. Not the confirmed
# mechanism (that's the cookie above) - kept only in case a different scheme is added.
PQA_CHATBOT_API_KEY=

# Optional. JSON object of extra request headers, merged in as-is.
PQA_CHATBOT_EXTRA_HEADERS_JSON=

# Optional. Request timeout in seconds. Default 120 if unset.
#PQA_CHATBOT_TIMEOUT=120

# Optional. Defaults to ./golden_dataset.json (relative to this folder) - put your own
# golden dataset there, or point this at wherever it lives.
#GOLDEN_DATASET_PATH=

# Optional. Defaults to ./data/artifacts/golden_dataset_new_chatbot_captured.json.
# Always a SEPARATE file from GOLDEN_DATASET_PATH - capture_new_chatbot.py never writes
# to the golden dataset it reads from.
#CAPTURED_DATASET_PATH=

# --- Golden dataset shape validation (capture/dataset_io.py's validate_row_counts) -----
# Defaults match this project's dataset (meity-pq-SHORT-2part-v1): 66 rows, all
# ragas_eligible, no judge-only rows. Change these only if the dataset changes.
#GOLDEN_EXPECTED_TOTAL_ROWS=66
#GOLDEN_EXPECTED_RAGAS_ELIGIBLE=66
# Comma-separated; empty string means "no judge-only rows at all".
#GOLDEN_EXPECTED_JUDGE_ONLY_IDS=
#MOC_EXPECTED_N=66
