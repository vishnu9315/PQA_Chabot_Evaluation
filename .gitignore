.env
.venv/
__pycache__/
.pytest_cache/
runs/
*.pyc

# Captured/output data is project-specific - keep the directory, not its contents.
# judge_prompts_v1.md is an input the scorer needs, so it is versioned.
data/artifacts/*
!data/artifacts/.gitkeep
!data/artifacts/judge_prompts_v1.md
# The 2026-11-20 capture of the MeitY chatbot and the scoring input built from it, so a
# teammate can score without re-capturing. The capture debug log stays local.
!data/artifacts/golden_dataset_new_chatbot_captured.json
!data/artifacts/golden_dataset_final_unified_eval.json

# Source documents (395 MB) are shared separately; drop them into documents/ locally.
documents/
documents*.zip

# Chatbot outputs from the login-only portal stay local.
runs_calib/
share/

# auth-capture/ has its own .gitignore for node_modules/.auth/etc.

# Safety net: never commit a session/storageState file if one is ever dropped here
# directly instead of referenced via PQA_CHATBOT_SESSION_FILE.
session*.json
*storageState*.json
