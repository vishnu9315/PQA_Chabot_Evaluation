# auth-capture — copy to .env and fill in. NEVER commit .env.

# The MeitY portal's login page.
PQA_BASE_URL=https://pqa.myscheme.in/meityy

# Optional. `npm run login` asks for your email, so you normally leave this empty. Set it
# only if you run `npm run auth:capture` directly.
PQA_IDENTITY_EMAIL=
